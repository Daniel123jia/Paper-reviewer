# OpenAI-compatible Chat Completions endpoint. Replace every placeholder locally.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=replace-with-your-model-name

# Optional per-million-token prices from the actual API provider. Keep these
# commented to record cost as unknown; never infer relay pricing from model names.
# OPENAI_INPUT_USD_PER_MILLION=0.00
# OPENAI_OUTPUT_USD_PER_MILLION=0.00

# Optional local data directory. The default is ./data.
# PAPER_REVIEW_DATA_DIR=/absolute/path/to/private-data

# Optional single-account access protection. Use a random value of at least 32 characters.
# PAPER_REVIEW_ACCESS_TOKEN=replace-with-a-random-32-character-or-longer-value
PAPER_REVIEW_PREDEPLOY=0
PAPER_REVIEW_SECURE_COOKIE=0
