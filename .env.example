# Required for every production model call. Replace every placeholder locally.
# OPENAI_BASE_URL must be an explicit HTTPS endpoint; the application has no
# implicit provider fallback. If a non-empty process value differs from the
# corresponding .env.local value, model actions fail closed instead of silently
# choosing either source. Process values are otherwise preferred.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=replace-with-your-model-name

# Optional per-million-token prices from the actual API provider. Keep these
# commented to record cost as unknown; never infer relay pricing from model names.
# OPENAI_INPUT_USD_PER_MILLION=0.00
# OPENAI_OUTPUT_USD_PER_MILLION=0.00
# A paid P5-R2 probe also requires an operator-checked provider price source.
# These fields record the human check; they are not independent verification or
# a provider account spending limit.
# OPENAI_PRICING_SOURCE_URL=https://provider.example/pricing
# OPENAI_PRICING_VERIFIED_AT=YYYY-MM-DD  # today or the preceding 30 calendar days
# OPENAI_PRICING_VERIFICATION=provider_source_checked

# Required for model-backed P4 report generation. Set every value explicitly
# from an approved per-report budget; there are no production defaults and the
# P5-R3B probe prices are not inherited. Zero prices are rejected.
# P4_MAX_PROVIDER_REQUESTS=8
# P4_MAX_INPUT_TOKENS=12000
# P4_MAX_OUTPUT_TOKENS=4000
# P4_MAX_OUTPUT_TOKENS_PER_REQUEST=500
# P4_MAX_DURATION_SECONDS=180
# P4_MAX_PLANNED_COST_USD=0.25
# P4_INPUT_USD_PER_MILLION=0.80
# P4_OUTPUT_USD_PER_MILLION=4.00
# P4_PRICING_STATUS=estimated_unverified

# Optional local data directory. The default is ./data.
# PAPER_REVIEW_DATA_DIR=/absolute/path/to/private-data

# Optional single-account access protection. Use a random value of at least 32 characters.
# PAPER_REVIEW_ACCESS_TOKEN=replace-with-a-random-32-character-or-longer-value
PAPER_REVIEW_PREDEPLOY=0
PAPER_REVIEW_SECURE_COOKIE=0
