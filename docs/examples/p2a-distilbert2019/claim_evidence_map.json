  "claims": [
    {
      "id": "claim_5781794966696eaf",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "A general-purpose pretrained language model can be successfully trained through distillation.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_1_0",
        "ru_ev_738e0f5c48b8_4_1"
      ]
    },
    {
      "id": "claim_f2c2895cdf0b221c",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The training objective linearly combines teacher-distribution distillation, supervised masked language modeling, and a cosine embedding loss intended to align the directions of student and teacher hidden-state vectors.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_9"
      ]
    },
    {
      "id": "claim_566105bda60abf77",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The distillation component trains the student using the teacher's soft target probabilities and full output distribution.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_6",
        "ru_ev_738e0f5c48b8_1_7"
      ]
    },
    {
      "id": "claim_9779f33f9c0b1f16",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "Teacher and student use the same softmax temperature during training, and the temperature is set to 1 at inference.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_8"
      ]
    },
    {
      "id": "claim_1d8dfeb2d48d9d90",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "DistilBERT retains BERT's general architecture while removing token-type embeddings and the pooler and reducing the number of layers by a factor of two.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_11"
      ]
    },
    {
      "id": "claim_f39a4b699e96c9c0",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The authors report that, at a fixed parameter budget, varying hidden size affects computational efficiency less than varying factors such as the number of layers, motivating their reduction in layer count.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_11"
      ]
    },
    {
      "id": "claim_fd8c95be2c48e6c3",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The authors report that ablation studies indicate all three components of the triple loss are important for achieving the best performance.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_1"
      ]
    },
    {
      "id": "claim_a988d37de6a98ee4",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "DistilBERT is reported to be 40% smaller than BERT.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_1_1",
        "ru_ev_738e0f5c48b8_4_1"
      ]
    },
    {
      "id": "claim_611de9ef8d44ac80",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "DistilBERT is reported to retain 97% of BERT's language understanding capabilities.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_4_1"
      ]
    },
    {
      "id": "claim_283486190c3131ec",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "DistilBERT is reported to be 60% faster than BERT.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_1_1",
        "ru_ev_738e0f5c48b8_4_1"
      ]
    },
    {
      "id": "claim_a793d18032424034",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "The authors report that the compressed pretrained model can be fine-tuned to achieve performance similar to larger models across several downstream tasks.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_0",
        "ru_ev_738e0f5c48b8_1_1"
      ]
    },
    {
      "id": "claim_63e2eafc9e7d920b",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "The authors report that the compressed model requires a smaller computational training budget and is cheaper to pretrain.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_1_0"
      ]
    },
    {
      "id": "claim_d1b1f2e3b68097f5",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "The authors report that their compressed models can run on mobile devices and that on-device capabilities are demonstrated through a proof-of-concept experiment and a comparative on-device study.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_0_5",
        "ru_ev_738e0f5c48b8_1_0"
      ]
    },
    {
      "id": "claim_6856c650a32f279f",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The student shares the teacher's dimensionality and is initialized by taking one teacher layer out of every two.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_1_12"
      ]
    },
    {
      "id": "claim_a2b450d58ed1c272",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "DistilBERT pretraining uses dynamic masking, gradient accumulation with batches of up to 4,000 examples, and no next sentence prediction objective.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_9"
      ]
    },
    {
      "id": "claim_c9ecc7ab08d7f657",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "DistilBERT was trained on English Wikipedia and Toronto Book Corpus using eight 16 GB V100 GPUs for approximately 90 hours.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_10"
      ]
    },
    {
      "id": "claim_7f94f2c3b02471d1",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "On the nine GLUE development-set tasks, DistilBERT matches or improves on the ELMo baseline and retains 97% of BERT's performance with 40% fewer parameters.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_12",
        "ru_ev_738e0f5c48b8_2_13",
        "ru_ev_738e0f5c48b8_2_0",
        "ru_ev_738e0f5c48b8_2_2"
      ]
    },
    {
      "id": "claim_6841112de060ce92",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "On IMDb, DistilBERT is reported to be 0.6 percentage points behind BERT in test accuracy while being 40% smaller.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_16",
        "ru_ev_738e0f5c48b8_2_8"
      ]
    },
    {
      "id": "claim_ee9962158c6d1fe1",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "On SQuAD, DistilBERT is reported to be within 3.9 points of full BERT; the prose does not specify the metric for this gap.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_16"
      ]
    },
    {
      "id": "claim_4bfe1aa731526603",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "An additional distillation step during SQuAD adaptation uses a BERT teacher previously fine-tuned on SQuAD to supply an additional loss term.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_2_17",
        "ru_ev_738e0f5c48b8_3_3"
      ]
    },
    {
      "id": "claim_8714842114919bb3",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "The prose reports that distillation during both pretraining and SQuAD adaptation achieves 79.8 F1 and 70.4 exact match, described as within three points of the full model.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_3"
      ]
    },
    {
      "id": "claim_48ba77f5678ab247",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "For a full pass over the STS-B development set with batch size 1 on an Intel Xeon E5-2690 v3 at 2.9 GHz, the authors report that DistilBERT has 40% fewer parameters and is 60% faster than BERT.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_5",
        "ru_ev_738e0f5c48b8_2_5",
        "ru_ev_738e0f5c48b8_2_7"
      ]
    },
    {
      "id": "claim_ebe71c95d1ed5ebe",
      "contribution_id": "contrib_a69a0c1a4bacd980",
      "statement": "In a question answering application on an iPhone 7 Plus, DistilBERT is reported to be 71% faster than the authors' BERT-base question answering model when tokenization is excluded, and the model occupies 207 MB.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_6"
      ]
    },
    {
      "id": "claim_09ff6e1b7fb028b5",
      "contribution_id": "contrib_0d14ae76d74073bd",
      "statement": "The ablation study evaluates components of the triple loss and student initialization using GLUE macro-score, reporting changes relative to the full triple loss.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_0",
        "ru_ev_738e0f5c48b8_3_1",
        "ru_ev_738e0f5c48b8_3_8"
      ]
    },
    {
      "id": "claim_0a57519d2ef17286",
      "contribution_id": "contrib_0d14ae76d74073bd",
      "statement": "The extracted ablation table reports GLUE macro-score changes of -2.96 when Lce is omitted, -1.46 when Lcos is omitted, -0.31 when Lmlm is omitted, and -3.69 when random initialization replaces teacher-weight initialization.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_2"
      ]
    },
    {
      "id": "claim_d28549b138b8a261",
      "contribution_id": "contrib_1566dbcdab589253",
      "statement": "The authors report that general-purpose pretraining distillation is beneficial compared with task-specific distillation, and that additional teacher distillation signals benefit pretraining.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_10"
      ]
    },
    {
      "id": "claim_c3cfff9dcf610ba7",
      "contribution_id": "contrib_0d14ae76d74073bd",
      "statement": "Removing the masked language modeling loss has little impact on GLUE macro-score, while the two distillation losses account for a large portion of performance.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_8"
      ]
    },
    {
      "id": "claim_2ff45f5c2970edc4",
      "contribution_id": "contrib_0d14ae76d74073bd",
      "statement": "Using teacher knowledge through initialization and additional losses yields substantial performance gains in the ablation study.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_3_11"
      ]
    },
    {
      "id": "claim_3884cb9074ac27d4",
      "contribution_id": "contrib_0d14ae76d74073bd",
      "statement": "The authors report demonstrating that DistilBERT is a compelling option for edge applications.",
      "evidence_ref_ids": [
        "ru_ev_738e0f5c48b8_4_1"
      ]
    }
  ],
